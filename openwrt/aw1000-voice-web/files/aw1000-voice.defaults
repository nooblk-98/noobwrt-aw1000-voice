#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Serve the phone management interface from its own uhttpd instance, on the
# port in aw1000_voice.web.port. The instance has its own /ubus and cgi-io, so
# the page talks to rpcd with the router's own login.

port=$(uci -q get aw1000_voice.web.port)
case "$port" in ''|*[!0-9]*) port=7766 ;; esac

uci -q batch <<EOF
set uhttpd.phone=uhttpd
delete uhttpd.phone.listen_http
add_list uhttpd.phone.listen_http='0.0.0.0:$port'
add_list uhttpd.phone.listen_http='[::]:$port'
set uhttpd.phone.home='/www/aw1000-voice'
set uhttpd.phone.rfc1918_filter='1'
set uhttpd.phone.max_requests='10'
set uhttpd.phone.max_connections='50'
set uhttpd.phone.cgi_prefix='/cgi-bin'
set uhttpd.phone.ubus_prefix='/ubus'
set uhttpd.phone.script_timeout='60'
set uhttpd.phone.network_timeout='30'
set uhttpd.phone.http_keepalive='20'
set uhttpd.phone.tcp_keepalive='1'
commit uhttpd
EOF

/etc/init.d/uhttpd reload >/dev/null 2>&1
exit 0
